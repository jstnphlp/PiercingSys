# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only credentials — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Piercing Corner <bookings@example.com>

# Google remains visible but disabled until both Supabase and Google are configured.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Prisma tooling may use a pooled URL, while schema inspection and seeding use
# DIRECT_URL. The application runtime itself uses the Supabase HTTP API.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PRISMA_SEED_EMAIL=
PRISMA_SEED_PASSWORD=
# Remote seeding is blocked unless this is explicitly enabled.
PRISMA_SEED_ALLOW_REMOTE=false
